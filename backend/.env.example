# Connection strings do Supabase (PostgreSQL)
# Pooling (porta 6543) para operações da aplicação
DATABASE_URL="postgresql://postgres.gsbdexctqjgcshasmsvc:[YOUR-PASSWORD]@aws-0-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Direta (porta 5432) para migrations do Prisma
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[SENHA]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Segredo para assinatura dos tokens JWT
JWT_SECRET="sua_chave_secreta_jwt_bem_segura"

# Credenciais do usuário mestre (Master / Administradora)
MASTER_USER_EMAIL="admin@exemplo.com"
# Hash bcrypt da senha do master (gerado com bcrypt, por ex: bcrypt.hashSync('senha123', 10))
MASTER_USER_PASSWORD_HASH="$2b$10$XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
